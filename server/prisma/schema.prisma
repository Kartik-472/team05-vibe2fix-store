datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

// ==========================================
// 1. IDENTITY & ADDRESS MANAGEMENT
// ==========================================

model User {
  id                String               @id @default(uuid()) @map("user_id")
  name              String
  email             String               @unique
  passwordHash      String               @map("password_hash")
  phone             String?
  role              String               @default("user") // "user" | "admin"
  isActive          Boolean              @default(true) @map("is_active")
  disabledReason    String?              @map("disabled_reason")
  sessions          Session[]
  emailVerifiedAt   DateTime? @map("email_verified_at")
  verifyTokenHash   String? @map("verify_token_hash")
  verifyExpiresAt   DateTime? @map("verify_expires_at")
  passwordChangedAt DateTime?            @map("password_changed_at")
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")

  addresses           Address[]
  cart                Cart?
  wishlist            Wishlist?
  orders              Order[]
  reviews             Review[]
  reportReviews       ReportReview[]
  moderatedReviews    ReviewModeration[]
  refunds             Refund[]
  couponUsages        CouponUsage[]
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

model Session {
  tokenHash String @id @map("token_hash")
  userId    String @map("user_id")
  expiresAt DateTime @map("expires_at")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Address {
  id          String   @id @default(uuid()) @map("address_id")
  userId      String   @map("user_id")
  name        String
  phone       String
  line1       String
  line2       String?
  city        String
  state       String
  pincode     String
  country     String   @default("India")
  addressType String   @default("home") @map("address_type")
  isDefault   Boolean  @default(false) @map("is_default")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

model PasswordResetToken {
  id        String   @id @default(uuid()) @map("reset_id")
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  isUsed    Boolean  @default(false) @map("is_used")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// ==========================================
// 2. CATALOG & CATEGORIES
// ==========================================

model Category {
  id          String   @id @default(uuid()) @map("category_id")
  name        String
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  products ProductCategory[]

  @@map("categories")
}

model Product {
  id          String   @id @default(uuid()) @map("product_id")
  name        String
  description String
  price       Decimal  @db.Decimal(10, 2)
  stock       Int
  avgRating   Decimal  @default(0.0) @map("avg_rating") @db.Decimal(3, 2)
  reviewCount Int      @default(0) @map("review_count")
  soldCount   Int      @default(0) @map("sold_count")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  images        ProductImage[]
  categories    ProductCategory[]
  cartItems     CartItem[]
  wishlistItems WishlistItem[]
  orderItems    OrderItem[]
  reviews       Review[]

  @@index([isActive])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(uuid()) @map("image_id")
  productId String   @map("product_id")
  imageUrl  String   @map("image_url")
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model ProductCategory {
  productId  String @map("product_id")
  categoryId String @map("category_id")

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@map("product_categories")
}

// ==========================================
// 3. CART & WISHLIST
// ==========================================

model Cart {
  id        String   @id @default(uuid()) @map("cart_id")
  userId    String   @unique @map("user_id")
  couponId  String?  @map("coupon_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  coupon Coupon?    @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items  CartItem[]

  @@map("carts")
}

model CartItem {
  id        String @id @default(uuid()) @map("cart_item_id")
  cartId    String @map("cart_id")
  productId String @map("product_id")
  quantity  Int

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
  @@map("cart_items")
}

model Wishlist {
  id        String   @id @default(uuid()) @map("wishlist_id")
  userId    String   @unique @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items WishlistItem[]

  @@map("wishlists")
}

model WishlistItem {
  id         String @id @default(uuid()) @map("wishlist_item_id")
  wishlistId String @map("wishlist_id")
  productId  String @map("product_id")

  wishlist Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([wishlistId, productId])
  @@map("wishlist_items")
}

// ==========================================
// 4. COUPONS & USAGE
// ==========================================

model Coupon {
  id          String   @id @default(uuid()) @map("coupon_id")
  code        String   @unique
  type        String   // "percent" | "flat"
  value       Decimal  @db.Decimal(10, 2)
  minOrder    Decimal  @default(0.0) @map("min_order") @db.Decimal(10, 2)
  maxDiscount Decimal? @map("max_discount") @db.Decimal(10, 2)
  expiry      DateTime
  usageLimit  Int      @default(100) @map("usage_limit")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  carts  Cart[]
  usages CouponUsage[]

  @@map("coupons")
}

model CouponUsage {
  id       String   @id @default(uuid()) @map("usage_id")
  couponId String   @map("coupon_id")
  userId   String   @map("user_id")
  orderId  String   @map("order_id")
  usedAt   DateTime @default(now()) @map("used_at")

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([couponId, userId])
  @@map("coupon_usages")
}

// ==========================================
// 5. ORDERS & CHECKOUT (COD ONLY)
// ==========================================

model Order {
  id             String    @id @default(uuid()) @map("order_id")
  userId         String    @map("user_id")
  orderNumber    String    @unique @map("order_number")
  addressName    String    @map("address_name")
  addressPhone   String    @map("address_phone")
  addressLine1   String    @map("address_line1")
  addressLine2   String?   @map("address_line2")
  addressCity    String    @map("address_city")
  addressState   String    @map("address_state")
  addressPincode String    @map("address_pincode")
  subtotal       Decimal   @db.Decimal(10, 2)
  discount       Decimal   @default(0.0) @db.Decimal(10, 2)
  shippingCharge Decimal   @default(0.0) @map("shipping_charge") @db.Decimal(10, 2)
  totalAmount    Decimal   @map("total_amount") @db.Decimal(10, 2)
  orderStatus    String    @default("Placed") @map("order_status") // Placed | Packed | Shipped | Out for Delivery | Delivered | Cancelled
  paymentStatus  String    @default("Pending") @map("payment_status") // Pending | Paid | Refunded
  courier        String?
  trackingId     String?   @map("tracking_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  deliveredAt    DateTime? @map("delivered_at")

  user          User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  items         OrderItem[]
  statusHistory OrderStatusHistory[]
  refunds       Refund[]
  couponUsages  CouponUsage[]

  @@index([userId])
  @@index([orderStatus])
  @@map("orders")
}

model OrderItem {
  id           String  @id @default(uuid()) @map("order_item_id")
  orderId      String  @map("order_id")
  productId    String  @map("product_id")
  productName  String  @map("product_name")
  quantity     Int
  price        Decimal @db.Decimal(10, 2)
  productImage String? @map("product_image")

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@map("order_items")
}

model OrderStatusHistory {
  id        String   @id @default(uuid()) @map("history_id")
  orderId   String   @map("order_id")
  status    String
  changedAt DateTime @default(now()) @map("changed_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_status_history")
}

// ==========================================
// 6. RETURNS & REFUNDS (7-DAY POLICY)
// ==========================================

model Refund {
  id        String   @id @default(uuid()) @map("refund_id")
  orderId   String   @map("order_id")
  userId    String   @map("user_id")
  reason    String
  amount    Decimal  @db.Decimal(10, 2)
  status    String   @default("Requested") // Requested | Approved | Refunded | Rejected
  adminNote String?  @map("admin_note")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  order         Order                 @relation(fields: [orderId], references: [id], onDelete: Restrict)
  user          User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  statusHistory RefundStatusHistory[]

  @@index([orderId])
  @@map("refunds")
}

model RefundStatusHistory {
  id        String   @id @default(uuid()) @map("history_id")
  refundId  String   @map("refund_id")
  status    String
  changedAt DateTime @default(now()) @map("changed_at")

  refund Refund @relation(fields: [refundId], references: [id], onDelete: Cascade)

  @@map("refund_status_history")
}

// ==========================================
// 7. REVIEWS, RATINGS & MODERATION
// ==========================================

model Review {
  id           String   @id @default(uuid()) @map("review_id")
  userId       String   @map("user_id")
  productId    String   @map("product_id")
  rating       Int
  comment      String
  reviewStatus String   @default("Active") @map("review_status") // Active | Flagged | Removed
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  product     Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  images      ReviewImage[]
  reports     ReportReview[]
  moderations ReviewModeration[]

  @@unique([userId, productId])
  @@map("reviews")
}

model ReviewImage {
  id        String   @id @default(uuid()) @map("image_id")
  reviewId  String   @map("review_id")
  imageUrl  String   @map("image_url")
  createdAt DateTime @default(now()) @map("created_at")

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
  @@map("review_images")
}

model ReportReview {
  id           String   @id @default(uuid()) @map("report_id")
  reviewId     String   @map("review_id")
  userId       String   @map("user_id")
  reportReason String   @map("report_reason")
  reportStatus String   @default("Pending") @map("report_status") // Pending | Dismissed | Resolved
  createdAt    DateTime @default(now()) @map("created_at")

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reviewId, userId])
  @@map("report_reviews")
}

model ReviewModeration {
  id        String   @id @default(uuid()) @map("moderation_id")
  adminId   String   @map("admin_id")
  reviewId  String   @map("review_id")
  action    String   // "Dismissed" | "Removed"
  reason    String
  createdAt DateTime @default(now()) @map("created_at")

  admin  User   @relation(fields: [adminId], references: [id], onDelete: Cascade)
  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@map("review_moderation")
}
